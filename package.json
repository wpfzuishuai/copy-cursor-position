{
  "name": "copy-cursor-position",
  "displayName": "Copy Cursor Position",
  "description": "Copy cursor position (file:line:col) to clipboard",
  "version": "0.2.0",
  "publisher": "JesseWu",
  "repository": "https://github.com/wpfzuishuai/copy-cursor-position",
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.92.0"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.mjs",
  "contributes": {
    "commands": [
      {
        "command": "copy-cursor-position.copyCursorPosition",
        "title": "Copy Cursor Position"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "copy-cursor-position.copyCursorPosition",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "command": "copy-cursor-position.copyCursorPosition",
        "key": "cmd+alt+c",
        "mac": "cmd+alt+c",
        "linux": "ctrl+alt+c",
        "win": "ctrl+alt+c",
        "when": "editorTextFocus"
      }
    ]
  },
  "scripts": {
    "compile": "rollup -c",
    "watch": "rollup -c -w",
    "test": "vitest run",
    "test:watch": "vitest",
    "pretest:integration": "tsc -p ./",
    "test:integration": "node ./out/test/runTest.js",
    "package": "vsce package"
  },
  "devDependencies": {
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.6.0",
    "@types/vscode": "^1.85.0",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.9.1",
    "rollup": "^4.60.2",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
